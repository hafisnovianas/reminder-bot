# ==========================================
# KONFIGURASI DATABASE & ZONA WAKTU
# ==========================================
# (Opsional) Lokasi database SQLite. Default: ./database.sqlite di root proyek.
DB_PATH=./database.sqlite

# Zona Waktu server agar jam pengingat akurat
TZ=Asia/Jakarta


# ==========================================
# KONFIGURASI ADMIN & AUTO-BACKUP
# ==========================================
# Nomor WhatsApp Admin (Gunakan format 62 tanpa + atau spasi)
# Diperlukan untuk menggunakan perintah khusus seperti "backup"
ADMIN_WA=6281234567890

# ID Folder Google Drive tempat menyimpan hasil auto-backup harian
GOOGLE_DRIVE_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J

# Kredensial OAuth2 Google Drive (Berupa JSON String yang solid/satu baris)
# HARUS diawali { dan diakhiri } TANPA ada karakter aneh di luarnya.
GOOGLE_CREDENTIALS={"client_id":"...","client_secret":"...","refresh_token":"..."}


# ==========================================
# KONFIGURASI PERFORMA & ANTI-SPAM (OPSIONAL)
# ==========================================
# Maksimal jumlah pengingat aktif per pengguna
# MAX_REMINDER_PER_USER=50

# Bersihkan riwayat pengingat setelah (n) hari
# SIMPAN_RIWAYAT_HARI=30

# Anti-Spam: Maksimal pesan dalam rentang waktu (ms)
# SPAM_THRESHOLD=7
# SPAM_WINDOW_MS=10000

# Broadcast limits: Max pesan per putaran Cron dan jedanya
# MAX_KIRIM_PER_PUTARAN=30
# JEDA_KIRIM_MS=1500

# Sesi tanya-jawab user akan hangus setelah (ms)
# SESI_KEDALUWARSA_MS=900000
